<Window x:Class="ATW11.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATW11 控制中心"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="LabelBrush" Color="#43556B" />
        <SolidColorBrush x:Key="ValueBrush" Color="#13202D" />

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Win7 风格的细滑杆 -->
        <Style x:Key="AeroSlider" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                    Background="#3DFFFFFF" BorderBrush="#26000000" BorderThickness="1" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="26" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="26" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="9" Background="#FBFFFFFF"
                                                        BorderBrush="#993D6EA5" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                                          Direction="270" Opacity="0.35" />
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 玻璃小按钮 -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1B2A38" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1"
                                BorderBrush="#8CFFFFFF" Background="#99FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66D9E9FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AeroCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#26384A" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 玻璃外壳 -->
    <Border x:Name="Shell" Margin="18" CornerRadius="14" BorderThickness="1" BorderBrush="#7AFFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                <GradientStop Color="#F2EAF4FE" Offset="0" />
                <GradientStop Color="#E6DCEAF8" Offset="0.45" />
                <GradientStop Color="#D9CDDFF1" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270"
                              Opacity="0.38" Color="#0B1520" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（可拖动窗口） ===== -->
            <Grid Grid.Row="0" x:Name="Header" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,14,10,8">
                    <Image x:Name="AppIconImage" Width="30" Height="30" Margin="0,0,10,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="控制中心" FontSize="17" FontWeight="SemiBold" Foreground="#13202D" />
                        <TextBlock Text="Win7 Aero 玻璃外壳 · 改动实时生效"
                                   FontSize="11.5" Foreground="#4A5A6E" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Margin="0,12,14,0"
                        VerticalAlignment="Top" Cursor="Hand" Background="#22000000"
                        MouseLeftButtonUp="Close_Click">
                    <TextBlock Text="✕" FontSize="11" Foreground="#37465A"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- ===== 设置内容 ===== -->
            <StackPanel Grid.Row="1" Margin="18,6,18,0">

                <Grid>
                    <TextBlock Text="玻璃透明度" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Style="{StaticResource ValueStyle}" />
                </Grid>
                <Slider x:Name="OpacitySlider" Style="{StaticResource AeroSlider}"
                        Minimum="0.45" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                        ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock Text="调低会更透，代价是能隐约看到被盖住的原生标签栏"
                           FontSize="11" Foreground="#6A7B90" Margin="0,2,0,0" />

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="壁纸模糊强度" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="BlurValue" HorizontalAlignment="Right" Style="{StaticResource ValueStyle}" />
                </Grid>
                <Slider x:Name="BlurSlider" Style="{StaticResource AeroSlider}"
                        Minimum="0" Maximum="80" SmallChange="1" LargeChange="5"
                        ValueChanged="BlurSlider_ValueChanged" />

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="玻璃色彩" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="ColorValue" HorizontalAlignment="Right" Style="{StaticResource ValueStyle}" />
                </Grid>
                <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Margin="0,8,0,0" />

                <Rectangle Height="1" Fill="#330F2030" Margin="0,16,0,2" />

                <CheckBox x:Name="AllWindowsCheck" Style="{StaticResource AeroCheck}"
                          Content="给所有资源管理器窗口都套壳（关掉则只套当前前台窗口）"
                          Click="AllWindowsCheck_Click" />

                <CheckBox x:Name="HintCheck" Style="{StaticResource AeroCheck}"
                          Content="在右下角显示提示条"
                          Click="HintCheck_Click" />

                <Rectangle Height="1" Fill="#330F2030" Margin="0,14,0,2" />

                <TextBlock x:Name="StatusText" Text="正在扫描窗口…"
                           FontSize="11.5" Foreground="#4A5A6E" Margin="0,8,0,0" />
            </StackPanel>

            <!-- ===== 底部按钮 ===== -->
            <Grid Grid.Row="2" Margin="18,14,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="恢复默认" Style="{StaticResource GlassButton}"
                        Click="Reset_Click" />
                <Button Grid.Column="2" x:Name="PauseButton" Content="暂停装饰"
                        Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="Pause_Click" />
                <Button Grid.Column="3" Content="退出程序" Style="{StaticResource GlassButton}"
                        Click="Exit_Click" />
            </Grid>

            <!-- ===== 右下角：版本号 + 反馈邮箱 ===== -->
            <TextBlock Grid.Row="3" x:Name="FooterText"
                       HorizontalAlignment="Right" Margin="18,10,20,14"
                       FontSize="11" Foreground="#5C6E82"
                       Text="v1.0　·　反馈：3807318397@qq.com" />
        </Grid>
    </Border>
</Window>
