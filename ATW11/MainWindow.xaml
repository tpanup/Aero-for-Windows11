<Window x:Class="ATW11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ATW11"
        mc:Ignorable="d"
        Title="ATW11 · Aero 原生窗口覆盖"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        TextOptions.TextFormattingMode="Ideal"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">

    <!-- 整个窗口就是一块"全屏透明玻璃"：
         除了给资源管理器画的外壳和右下角的提示，其他像素全是 alpha=0，
         鼠标点击直接穿透到下面的真实窗口。 -->
    <Grid Background="Transparent">

        <!-- 所有 Aero 外壳都挂在这个 Canvas 上，按原生窗口坐标摆放 -->
        <Canvas x:Name="FrameLayer" Background="Transparent" ClipToBounds="True" />

        <!-- 右下角提示 / 退出兜底：几秒后自动淡出；万一 Esc 热键被系统占用，这行字本身可以点 -->
        <Border x:Name="HintChip"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,52" Padding="13,8"
                CornerRadius="11" Opacity="0"
                Cursor="Hand"
                BorderThickness="1" BorderBrush="#59FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D91B2A3A" Offset="0" />
                    <GradientStop Color="#D91A2431" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="HintText"
                       Text="ATW11 · 正在为资源管理器套上 Win7 Aero 玻璃"
                       FontFamily="Segoe UI" FontSize="12.5"
                       Foreground="#F2FFFFFF" />
        </Border>
    </Grid>
</Window>
